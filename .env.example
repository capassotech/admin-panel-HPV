# Plantilla de variables de entorno (Vite)
# Los valores reales van en:
#   .env.development  → QA  (home-pisos-admin-qa)  → npm run dev | npm run build:dev
#   .env.production   → PROD (home-pisos-admin)     → npm run build
#
# Obtener credenciales Firebase:
#   Firebase Console → [proyecto] → Configuración → Tus apps → SDK web

VITE_API_URL=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
